# --- Remote YDB (Yandex Cloud) ---
# YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
# YDB_DATABASE=/ru-central1/b1gxxxxxxxxxx/etnxxxxxxxxxx
# YC_SA_JSON=
# YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=./sa-key.json

# --- YDB Local (docker compose) — не ставь SA key вместе с ANONYMOUS ---
YDB_ENDPOINT=grpc://localhost:2136
YDB_DATABASE=/local
YDB_ANONYMOUS_CREDENTIALS=1

# Telegram
BOT_TOKEN=123456:ABC-DEF
WEBHOOK_SECRET=random-secret-string
ALLOWED_CHAT_ID=-1001234567890
MINI_APP_URL=http://localhost:5173

# Опционально
DEFAULT_TIMEZONE=Europe/Moscow
ADMIN_USER_IDS=123456789
# Новый dispatcher пока включается только вручную после применения target-миграций
UNIVERSAL_REMINDERS_ENABLED=0

BOT_MODE=polling
PORT=3000
NODE_ENV=development
SKIP_INIT_DATA_VALIDATION=1
DEV_USER_ID=123456789
