# Базовый URL API (без trailing slash).
# Оставь пустым только локально, если используешь Vite proxy.
# Production workflow подставляет базовый URL API Gateway из WEBHOOK_URL.
VITE_API_BASE_URL=

# Валидный initData для браузера без Telegram.
# Сгенерировать: npm run dev:init-data
VITE_DEV_INIT_DATA=

# Username бота без @. Используется для восстановления входа из браузера.
VITE_BOT_USERNAME=zvenfit_reminder_bot
