{
  "name": "zvenfit-reminder",
  "private": true,
  "workspaces": [
    "packages/*",
    "functions/*",
    "mini-app"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:bot": "npm run dev --workspace=@zvenfit-reminder/bot-webhook",
    "dev:cron": "npm run dev --workspace=@zvenfit-reminder/reminder-cron",
    "dev:init-data": "node --env-file=.env --import tsx scripts/generate-init-data.ts",
    "dev:stack": "docker compose up -d && ./scripts/ydb-local-init.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
