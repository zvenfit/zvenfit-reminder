{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zvenfit-reminder-webhook-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Routine public 2xx/4xx are suppressed in code; keep dependency and 5xx
      // events complete for incident investigation.
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "vars": {
    "ORIGIN_URL": "https://functions.yandexcloud.net/d4e3h1o2eoa1vp5g7ec5"
  },
  "secrets": {
    "required": ["TELEGRAM_PROXY_SECRET"]
  }
}
